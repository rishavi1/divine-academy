rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null && request.auth.uid == 'IKOFW1ZaP0erGRstYo6IMK8wNju2';
    }
    match /lessons/{lessonId} {
      allow read: if isTeacher() || resource.data.published == true;
      allow create: if isTeacher()
        && request.resource.data.keys().hasAll(['className','subject','chapter','lessonNumber','title','url','description','published','createdBy'])
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }
  }
}
